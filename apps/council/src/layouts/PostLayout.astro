---
import { Image } from 'astro:assets';
import Comments from '../components/Comments.astro';
import FormattedDate from '../components/FormattedDate.astro';
import SeriesNav from '../components/SeriesNav.astro';
import { readingTime, tagSlug, type Post } from '../lib/posts';
import BaseLayout from './BaseLayout.astro';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const {
  title,
  description,
  published,
  updated,
  tags,
  series,
  draft,
  comments,
  heroImage,
  heroImageAlt,
} = post.data;
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedTime={published}
  image={`/og/posts/${post.id}.png`}
>
  <article class="post" data-pagefind-body>
    {
      heroImage && (
        <Image
          class="post__hero breakout"
          src={heroImage}
          alt={heroImageAlt ?? ''}
          widths={[640, 960, 1280, 2048]}
          sizes="(min-width: 70rem) 64rem, 100vw"
          loading="eager"
          fetchpriority="high"
        />
      )
    }
    <header class="post__header">
      {
        series && (
          <p class="eyebrow">
            <a href={`/series/${tagSlug(series)}/`}>{series}</a>
          </p>
        )
      }
      <h1 data-pagefind-meta="title">{title}</h1>
      <p class="lede">{description}</p>
      <p class="post__meta" data-pagefind-ignore>
        <FormattedDate date={published} />
        {
          updated && (
            <>
              <span aria-hidden="true">·</span>
              <span>
                Updated <FormattedDate date={updated} />
              </span>
            </>
          )
        }
        <span aria-hidden="true">·</span>
        <span>{readingTime(post)} min read</span>
        {draft && <strong class="post__draft">Draft: not published</strong>}
      </p>
    </header>

    <SeriesNav post={post} position="top" />

    <div class="prose">
      <slot />
    </div>

    <SeriesNav post={post} position="bottom" />

    {
      tags.length > 0 && (
        <footer class="post__footer" data-pagefind-ignore>
          <h2 class="visually-hidden">Tags</h2>
          <ul class="tag-list">
            {tags.map((tag) => (
              <li>
                <a class="tag" href={`/tags/${tagSlug(tag)}/`} data-pagefind-filter="tag">
                  {tag}
                </a>
              </li>
            ))}
          </ul>
        </footer>
      )
    }
  </article>

  {/* Not on drafts: the first comment would create a public discussion for an unpublished post. */}
  {comments && !draft && <Comments term={post.id} />}
</BaseLayout>

<style>
  /* Reading-column width on small screens, wider (.breakout) on large ones. */
  .post__hero {
    display: block;
    margin-bottom: var(--space-8);
    border-radius: var(--radius);
  }

  .post__header {
    margin-bottom: var(--space-12);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--brass);
  }

  .post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    color: var(--text-muted);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
  }

  .eyebrow a {
    color: inherit;
    text-decoration: none;
  }

  .eyebrow a:hover {
    text-decoration: underline;
  }

  .post__draft {
    color: var(--accent);
  }

  .post__footer {
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: var(--rule);
  }
</style>
