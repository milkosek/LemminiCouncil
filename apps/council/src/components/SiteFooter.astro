---
import { site } from '../site.config';

const year = new Date().getFullYear();
const { github, linkedin } = site.social;

// Short names keep each link on one line when Prettier formats this file. A line break inside a
// link would end up in the page as an extra, underlined space after the link text.
const licences = {
  writing: 'https://creativecommons.org/licenses/by/4.0/',
  code: `${site.repo}/blob/main/LICENSE`,
};
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <p class="site-footer__promise">No trackers. No dark patterns.</p>

    <ul class="site-footer__links">
      <li>
        <a href="/rss.xml">RSS</a>
      </li>
      {github && (
        <li>
          <a href={`https://github.com/${github}`} rel="me">
            GitHub
          </a>
        </li>
      )}
      {linkedin && (
        <li>
          <a href={linkedin} rel="me">
            LinkedIn
          </a>
        </li>
      )}
      <li>
        <a href="/privacy/">Privacy</a>
      </li>
    </ul>

    <p class="site-footer__copy">
      © {year} {site.author} · {site.title} · Writing
      <a href={licences.writing} rel="license">
        CC BY 4.0
      </a>{' '}
      · Code
      <a href={licences.code}>Apache 2.0</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--rule);
    color: var(--text-muted);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4) var(--space-8);
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--space-8) var(--gutter);
  }

  .site-footer p {
    margin: 0;
  }

  .site-footer__promise {
    color: var(--brass);
    font-variant-caps: all-small-caps;
    letter-spacing: 0.1em;
    font-size: 1rem;
  }

  .site-footer__links {
    display: flex;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer a {
    color: var(--text-muted);
  }

  .site-footer a:hover {
    color: var(--text);
  }
</style>
