---
import { postUrl, readingTime, type Post } from '../lib/posts';
import FormattedDate from './FormattedDate.astro';

interface Props {
  posts: Post[];
  /** Shown when there are no posts. */
  empty?: string;
}

const { posts, empty = 'The Council has not yet convened.' } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="empty-state">{empty}</p>
  ) : (
    <ol class="post-list">
      {posts.map((post) => (
        <li class="post-list__item">
          <p class="post-list__meta">
            <FormattedDate date={post.data.published} />
            <span aria-hidden="true">·</span>
            <span>{readingTime(post)} min read</span>
            {post.data.draft && <span class="post-list__draft">Draft</span>}
          </p>
          <h3 class="post-list__title">
            <a href={postUrl(post)}>{post.data.title}</a>
          </h3>
          <p class="post-list__description">{post.data.description}</p>
        </li>
      ))}
    </ol>
  )
}

<style>
  .post-list {
    display: grid;
    gap: var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .post-list__meta {
    display: flex;
    gap: var(--space-2);
    margin: 0 0 var(--space-1);
    color: var(--text-muted);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
  }

  .post-list__draft {
    margin-left: var(--space-2);
    padding: 0 0.5em;
    border: 1px dashed var(--accent);
    border-radius: var(--radius);
    color: var(--accent);
  }

  .post-list__title {
    margin: 0 0 var(--space-2);
    font-size: var(--text-xl);
  }

  .post-list__title a {
    color: var(--text);
    text-decoration: none;
  }

  .post-list__title a:hover {
    color: var(--accent);
  }

  .post-list__description {
    margin: 0;
    color: var(--text-muted);
  }
</style>
