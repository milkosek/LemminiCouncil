---
import PostList from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, groupByTag, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const tags = groupByTag(await getPublishedPosts());
  return tags.map(({ tag, slug, posts }) => ({
    params: { tag: slug },
    props: { tag, posts },
  }));
}

interface Props {
  tag: string;
  posts: Post[];
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`Tagged “${tag}”`} description={`Posts tagged ${tag}.`}>
  <p class="eyebrow"><a href="/tags/">Tags</a></p>
  <h1>{tag}</h1>
  <PostList posts={posts} />
</BaseLayout>
