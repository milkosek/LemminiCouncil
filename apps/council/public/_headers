# Response headers, applied by Cloudflare Workers static assets.
# The main Content-Security-Policy is a <meta> tag that Astro adds to each page (astro.config.mjs).
# This header adds the parts a <meta> tag can't carry. Browsers enforce both policies.

# Strict-Transport-Security: HTTPS only. Browsers that have visited once refuse plain http:// for a
# year, for this domain and its subdomains (every Lemmini Council site runs on Cloudflare with
# HTTPS). Cloudflare's "Always Use HTTPS" redirects first visits; this covers the ones after.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Our giscus comment themes are loaded by the giscus iframe with crossorigin="anonymous".
/giscus/*
  Access-Control-Allow-Origin: https://giscus.app
