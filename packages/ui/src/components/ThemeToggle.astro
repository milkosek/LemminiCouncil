---
/**
 * Switches between "The Chamber at Night" (default) and "The Chamber by Day".
 *
 * Plain Astro + a tiny bundled script, no Vue: the header is on every page, and pulling in a
 * framework just for one button put Vue on the critical path of every page load.
 *
 * The choice is kept in localStorage only (no cookie). The matching pre-paint script is
 * apps/council/public/scripts/theme-init.js. Without JavaScript the button stays invisible
 * (it still reserves its space, so nothing shifts when it appears).
 */
---

<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  aria-label="Switch to the day theme"
  title="Switch to the day theme"
>
  <svg class="theme-toggle__moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
    <path
      d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linejoin="round"></path>
  </svg>
  <svg class="theme-toggle__sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
    <circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
    <path
      d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"></path>
  </svg>
</button>

<script>
  const STORAGE_KEY = 'lc-theme';
  const root = document.documentElement;

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    const syncLabel = () => {
      const label =
        root.dataset.theme === 'day' ? 'Switch to the night theme' : 'Switch to the day theme';
      button.setAttribute('aria-label', label);
      button.title = label;
    };

    button.addEventListener('click', () => {
      const next = root.dataset.theme === 'day' ? 'night' : 'day';
      root.dataset.theme = next;
      try {
        if (next === 'day') localStorage.setItem(STORAGE_KEY, 'day');
        else localStorage.removeItem(STORAGE_KEY);
      } catch {
        // Storage unavailable (private mode, blocked site data). The theme still switches.
      }
      syncLabel();
    });

    syncLabel();
    button.classList.add('is-ready');
  }
</script>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: transparent;
    color: var(--brass);
    cursor: pointer;
    /* Hidden until the script has wired it up; the space is reserved either way. */
    visibility: hidden;
    transition:
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .theme-toggle.is-ready {
    visibility: visible;
  }

  .theme-toggle:hover {
    border-color: var(--brass);
    color: var(--text);
  }

  .theme-toggle__sun {
    display: none;
  }

  :global([data-theme='day']) .theme-toggle__moon {
    display: none;
  }

  :global([data-theme='day']) .theme-toggle__sun {
    display: block;
  }
</style>
