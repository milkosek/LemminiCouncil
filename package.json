{
  "name": "lemmini-council",
  "private": true,
  "type": "module",
  "description": "Source for lemminicouncil.org",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "pnpm --filter @lemmini/council dev",
    "build": "pnpm --filter @lemmini/council build",
    "preview": "pnpm --filter @lemmini/council preview",
    "check": "pnpm -r --if-present check",
    "test": "pnpm -r --if-present test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@lemmini/config": "workspace:*",
    "eslint": "^10.0.0",
    "prettier": "^3.6.0",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.0"
  }
}
