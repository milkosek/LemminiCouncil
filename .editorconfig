root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# Keep the byte-order mark: it tells browsers this plain-text file is UTF-8 (for the ł and arrows),
# since static hosts serve .txt without a charset.
[apps/council/public/humans.txt]
charset = utf-8-bom
